[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId={cd0342e6-b64b-43f4-b34a-837cbe123ebd}
Provider=%Provider%
DriverVer=11/17/2026,0.1.0.0
CatalogFile=dspi-usb-extension.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Extensions,NTamd64.10.0.1..19041,NTamd64.10.0.1..22000
[Extensions.NTamd64.10.0.1..19041]
%Description%=DspiExtension,USB\VID_2E8B&PID_FEAA&REV_0204&MI_00
%Description%=DspiExtension,USB\VID_2E8B&PID_FEAA&MI_00
[Extensions.NTamd64.10.0.1..22000]

[DspiExtension.NT]
[DspiExtension.NT.Components]
AddComponent=DspiApo,,Dspi.Component
[Dspi.Component]
ComponentIDs=VEN_DSPI&CID_E53F75EF
Description="DSPi Standalone APO (development)"
[DspiExtension.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,GLOBAL,Dspi.AudioInterface
[Dspi.AudioInterface]
AddReg=Dspi.Fx
[Dspi.Fx]
; FX outranks the entire inbox MSFX store. Represent the exact inspected
; Windows chain in this new speaker store; do not modify any MSFX key.
; NOCLOBBER is not atomic installation: a future installer must preflight/recover.
HKR,FX\0,%PKEY_ASSOCIATION%,0x00000002,%SPEAKER_ASSOCIATION%
HKR,FX\0,%PKEY_SFX%,0x00000002,%WINDOWS_SFX%
HKR,FX\0,%PKEY_MFX%,0x00000002,%WINDOWS_MFX%
HKR,FX\0,%PKEY_SFX_MODES%,0x00010002,%MODE_DEFAULT%
HKR,FX\0,%PKEY_MFX_MODES%,0x00010002,%MODE_DEFAULT%
HKR,FX\0,%PKEY_WINDOWS_UI%,0x00000002,%WINDOWS_UI%
HKR,FX\0,%PKEY_ITEM_DISPLAY%,0x00000002,"Microsoft Audio Home Theater Effects"
HKR,FX\0,%PKEY_EFX%,0x00000002,%Clsid%
HKR,FX\0,%PKEY_EFX_MODES%,0x00010002,%MODE_DEFAULT%
HKR,FX\0,%PKEY_PROFILE%,0x00000002,"@@PROFILE_KEY@@"
; Exact USB hardware IDs still match every device of this model; no serial targeting.
